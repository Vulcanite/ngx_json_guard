ngx_addon_name=ngx_http_json_guard_module

if test -n "$ngx_module_link"; then
    # Dynamic / addon build (nginx 1.9.11+)
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_json_guard_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_json_guard_module.c \
                     $ngx_addon_dir/src/json_guard_parser.c"
    ngx_module_incs="$ngx_addon_dir/src"
    . auto/module
else
    # Legacy static addon build
    HTTP_MODULES="$HTTP_MODULES ngx_http_json_guard_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
                    $ngx_addon_dir/ngx_http_json_guard_module.c \
                    $ngx_addon_dir/src/json_guard_parser.c"
    CFLAGS="$CFLAGS -I$ngx_addon_dir/src"
fi
