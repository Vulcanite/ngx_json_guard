# Example production-style NGINX config for ngx_json_guard + ModSecurity.
# Adjust paths for your install layout.

load_module modules/ngx_http_json_guard_module.so;
# This order is expected for the documented build, but effective PREACCESS
# order must be verified with the exact NGINX and ModSecurity module binaries.
load_module modules/ngx_http_modsecurity_module.so;

worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /var/log/nginx/access.log;

    # Large JSON bodies: spool to disk, keep memory buffer small.
    client_max_body_size 500m;
    client_body_buffer_size 64k;
    client_body_in_file_only clean;
    client_body_temp_path /var/lib/nginx/client_body_temp 1 2;

    sendfile on;
    keepalive_timeout 65;

    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;

    upstream backend {
        server 127.0.0.1:9000;
    }

    server {
        listen 8080;
        server_name _;

        location /api/ {
            json_guard on;
            json_guard_max_depth 100;
            json_guard_max_string_length 1048576;
            json_guard_max_key_length 4096;
            json_guard_max_number_length 256;
            json_guard_max_total_tokens 10000000;
            json_guard_max_object_members 1000000;
            json_guard_max_array_elements 1000000;
            json_guard_allow_top_level_scalar off;
            # Optional bounded fingerprint-based duplicate-key rejection.
            # json_guard_reject_duplicate_keys on;
            # Default methods: POST PUT PATCH. Empty bodies are passed through.
            # json_guard_methods POST PUT PATCH;

            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_request_buffering on;
        }

        location /healthz {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }
    }
}
