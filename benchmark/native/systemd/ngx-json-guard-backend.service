[Unit]
Description=ngx_json_guard native benchmark body sink
After=network.target

[Service]
Type=simple
User=ngxjsonbench
Group=ngxjsonbench
ExecStart=/usr/bin/python3 /opt/ngx-json-guard/benchmark/native_body_sink.py --host 127.0.0.1 --port 9100
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
LimitNOFILE=65536
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
