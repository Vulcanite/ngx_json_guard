{
  "nginx-baseline": {
    "family": "nginx",
    "runtime": {"type": "systemd", "unit": "ngx-json-guard-nginx.service"},
    "base_url": "http://127.0.0.1:8091",
    "nginx_profile": "off.conf",
    "rule_profile": "processor.conf",
    "profile": "pass-through baseline",
    "routes": {"json": "/json/", "xml": "/xml/", "form": "/form/", "web": "/web/"},
    "timing_headers": {"upstream_us": "X-Upstream-Processing-Us"},
    "log_locations": {"access": "/var/log/ngx-json-guard/nginx-access.log", "error": "/var/log/ngx-json-guard/nginx-error.log"},
    "version_commands": {"nginx": ["/opt/ngx-json-guard/nginx/sbin/nginx", "-V"]},
    "backend_units": ["ngx-json-guard-backend.service"],
    "backend_metrics_url": "http://127.0.0.1:9100/metrics",
    "validates_json": false,
    "json_guard": false,
    "crs": false
  },
  "nginx-guard": {
    "family": "nginx",
    "runtime": {"type": "systemd", "unit": "ngx-json-guard-nginx.service"},
    "base_url": "http://127.0.0.1:8091",
    "nginx_profile": "guard.conf",
    "rule_profile": "processor.conf",
    "profile": "JSON Guard only",
    "routes": {"json": "/json/", "xml": "/xml/", "form": "/form/", "web": "/web/"},
    "timing_headers": {"json_guard_us": "X-Json-Guard-Inspection-Us", "upstream_us": "X-Upstream-Processing-Us"},
    "log_locations": {"access": "/var/log/ngx-json-guard/nginx-access.log", "error": "/var/log/ngx-json-guard/nginx-error.log"},
    "version_commands": {"nginx": ["/opt/ngx-json-guard/nginx/sbin/nginx", "-V"]},
    "backend_units": ["ngx-json-guard-backend.service"],
    "backend_metrics_url": "http://127.0.0.1:9100/metrics",
    "validates_json": true,
    "json_guard": true,
    "crs": false
  },
