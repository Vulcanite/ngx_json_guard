[Unit]
Description=ngx_json_guard remote benchmark body sink
After=network.target

[Service]
Type=simple
User=ngxjsonapi
Group=ngxjsonapi
EnvironmentFile=/etc/ngx-json-guard-api/api.env
ExecStart=/usr/bin/python3 /opt/ngx-json-guard-api/native_body_sink.py --host ${API_BIND_ADDRESS} --port ${API_PORT}
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
LimitNOFILE=65536
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
